# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Python
*.py text eol=lf
*.pkl binary

# Shell scripts
*.sh text eol=lf

# Configuration files
.env text eol=lf
.env.* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# iOS
*.pbxproj binary
*.xcworkspace binary
*.storyboard binary

# Android
*.gradle binary
*.properties text eol=lf
