# Configuration pour les tests inter-wallet
# Copier ce fichier en .env.test et remplir les valeurs

# URL de votre projet Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# JWT Token d'un utilisateur authentifié
# Obtenir via : Login dans l'app ou via API auth
USER_JWT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API Key du wallet externe (générée via SQL)
# Obtenir via : Exécuter create_test_wallets.sql
WALLET_API_KEY=epw_your_generated_api_key_here

# Configuration des wallets de test
SOURCE_WALLET_ID=wallet_paris_test
DESTINATION_WALLET_ID=wallet_lyon_test

# Montants de test
TEST_AMOUNT_SMALL=50.00
TEST_AMOUNT_MEDIUM=200.00
TEST_AMOUNT_LARGE=1000.00

# Mode debug
DEBUG=true
